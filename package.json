{
  "name": "cinextma",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "electron-forge start",
    "electron:prepare": "node scripts/prepare-standalone.mjs",
    "electron:build": "next build && npm run electron:prepare",
    "electron:package": "npm run electron:build && electron-builder --mac dmg",
    "electron:dev": "npm run electron:build && cross-env ELECTRON_RUN_AS_NODE= electron .",
    "electron:run:testmode": "npm run electron:build && cross-env ELECTRON_RUN_AS_NODE= ELECTRON_TEST_MODE=true electron .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:electron": "npm run electron:build && playwright test --config=playwright.electron.config.ts",
    "test:electron:debug": "npm run electron:build && playwright test --config=playwright.electron.config.ts --debug",
    "test:electron:headed": "npm run electron:build && playwright test --config=playwright.electron.config.ts --headed",
    "test:web-security": "playwright test --config=playwright.web-security.config.ts",
    "test:performance": "node scripts/performance-baseline.mjs",
    "test:performance:report": "node scripts/generate-performance-report.mjs",
    "test:load": "node load-tests/simple-load-test.mjs",
    "test:load:k6": "k6 run load-tests/api-load-test.js",
    "security:guard": "node scripts/security-guard.mjs",
    "verify": "npm run security:guard && npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:electron": "npm run security:guard && npm run test:electron",
    "sb-start": "supabase start --debug --ignore-health-check",
    "sb-stop": "supabase stop --debug --all",
    "sb-restart": "supabase stop --debug --all && supabase start --debug --ignore-health-check",
    "sb-db-reset": "supabase db reset",
    "sb-db-types": "supabase gen types typescript --local > src/utils/supabase/types.ts",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@heroui/react": "^2.8.3",
    "@hookform/resolvers": "^5.2.1",
    "@mantine/hooks": "^8.2.4",
    "@marsidev/react-turnstile": "^1.3.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.108.1",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.85.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "date-fns": "^4.1.0",
    "electron": "^42.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "react-share": "^5.2.2",
    "string-ts": "^2.2.1",
    "tailwindcss-motion": "^1.1.1",
    "tmdb-ts": "^2.0.2",
    "use-long-press": "^3.3.0",
    "vaul": "^1.1.2",
    "yet-another-react-lightbox": "^3.25.0",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@iconify/react": "^6.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@tanstack/react-query-devtools": "^5.85.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/ui": "^3.0.0",
    "chrome-launcher": "^1.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.2.1",
    "jsdom": "^26.0.0",
    "k6": "^0.0.0",
    "lighthouse": "^13.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^3.0.0",
    "webpack": "^5.101.2"
  },
  "build": {
    "appId": "com.cinextma.desktop",
    "productName": "Cinextma",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "electron/main.cjs",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg"
      ],
      "icon": "public/icons/ios/512.png"
    },
    "dmg": {
      "title": "Cinextma",
      "artifactName": "Cinextma-${version}-${arch}.dmg"
    }
  },
  "prettier": {
    "proseWrap": "never",
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
